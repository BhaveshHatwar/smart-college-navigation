rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------

    // Is someone logged in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Is the logged-in user the owner of this user document?
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Is the logged-in user an admin? Looks at users/{uid}.role.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Checks the data of a location being saved.
    function validLocation(locationId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'name', 'floor', 'type', 'nodeId'])
        && locationId.matches('^[A-Z]-[A-Z0-9-]+$')
        && d.id == locationId
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.floor in ['C', 'D', 'E', 'F']
        && d.type in ['Classroom', 'Laboratory', 'Office', 'Hall', 'Facility', 'Lift', 'Stairs']
        && d.nodeId is string && d.nodeId.size() > 0 && d.nodeId.size() <= 60
        && (!('description' in d) || (d.description is string && d.description.size() <= 500));
    }

    // ---------- users ----------
    match /users/{userId} {
      // Read your own profile. Admins can read everyone (the Users table).
      allow read: if isOwner(userId) || isAdmin();

      // Register: create ONLY your own document, ONLY as a student.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.createdAt == request.time;

      // Edit your own profile, but ONLY the name (so nobody can change "role").
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      allow delete: if false;
    }

    // ---------- locations ----------
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && validLocation(locationId);
      allow delete: if isAdmin();
    }

    // ---------- floors ----------
    match /floors/{floorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Everything else is closed by default (no rule = no access).
  }
}